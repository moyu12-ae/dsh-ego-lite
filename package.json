{
  "name": "@dsh-external/ego-browser",
  "version": "0.9.0",
  "description": "ego-browser (ego-lite) integration plugin for DSH: structured browser-automation tools (30+ ego_*) driving the LOCAL official ego lite app (or the vendored fallback runtime) through ctx.subprocess.",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib/",
    "bin/",
    "runtime/",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsdown -c tsdown.config.ts"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
    "schemastery": "^3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "schemastery": "^3.18.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
