{
  "name": "dsh-ego-lite",
  "version": "0.9.3",
  "description": "dsh-ego-lite - the structured DSH <=> ego lite bridge: 32 ego_* tools driving the LOCAL official ego lite app. A no-PR personal rework based on Fisfzy/dsh-ego-browser v0.8.0 and the official CitroLabs/ego-lite ego-skills/ego-browser skill.",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib/",
    "bin/",
    "runtime/",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsdown -c tsdown.config.ts"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8",
    "schemastery": "^3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "schemastery": "^3.18.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
